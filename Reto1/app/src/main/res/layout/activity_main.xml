
<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFBFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejemplo de componentes Android"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="22dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Componentes para mostrar información"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#333333"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Este texto se muestra mediante un TextView."
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            android:textColor="#555555"/>

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:src="@android:drawable/sym_def_app_icon"
            android:contentDescription="Logo Android"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progreso: 50%"
            android:textSize="13sp"/>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:progressTint="#6750A4"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VideoView"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="6dp"/>

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="100dp"
            android:layout_height="180dp"
            android:background="#000000"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WebView"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="#FFFFFF"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Componentes de entrada e interacción"
            android:textStyle="bold"
            android:textColor="#333333"
            android:textSize="15sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Introduce tu nombre"
            android:inputType="textPersonName"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona tecnologías:"
            android:textSize="14sp"
            android:layout_marginTop="18dp"/>

        <CheckBox
            android:id="@+id/cbAndroid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Android"
            android:textSize="14sp"/>

        <CheckBox
            android:id="@+id/cbReact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="React"
            android:textSize="14sp"/>

        <CheckBox
            android:id="@+id/cbFlutter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flutter"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona una modalidad:"
            android:textSize="14sp"
            android:layout_marginTop="18dp"/>

        <RadioGroup
            android:id="@+id/rgModalidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:checkedButton="@id/rbPresencial">

            <RadioButton
                android:id="@+id/rbPresencial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Presencial"
                android:textSize="14sp"/>

            <RadioButton
                android:id="@+id/rbOnline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online"
                android:textSize="14sp"/>

            <RadioButton
                android:id="@+id/rbMixta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mixta"
                android:textSize="14sp"/>

        </RadioGroup>

        <Switch
            android:id="@+id/swNotificaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notificaciones"
            android:textSize="14sp"
            android:layout_marginTop="14dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona un curso:"
            android:textSize="14sp"
            android:layout_marginTop="20dp"/>

        <Spinner
            android:id="@+id/spCurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvNivel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nivel seleccionado: 50"
            android:textSize="14sp"
            android:layout_marginTop="18dp"/>

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:progressTint="#6750A4"
            android:thumbTint="#6750A4"/>

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar información"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6750A4"
            android:layout_marginTop="18dp"/>

        <Button
            android:id="@+id/btnGuardar2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar información"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6750A4"
            android:layout_marginTop="14dp"/>

        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aquí aparecerá el resultado."
            android:textSize="14sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="30dp"
            android:gravity="center"
            android:textColor="#555555"/>

    </LinearLayout>

</ScrollView>
